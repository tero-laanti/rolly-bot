    "claimLabel": "Dive",
    "claimPolicy": "first-click",
    "claimWindowSeconds": 45,
    "flow": {
      "type": "solo-push-your-luck",
      "timeoutResolution": "cash-out-current-pot",
      "stages": [
        {
          "id": "shallow-pull",
          "label": "Shallow pull",
          "prompt": "Roll 4+ on d8 to come back with something useful.",
          "actionLabel": "Dive",
          "rollChallenge": {
            "id": "example-push-step-one",
            "mode": "single-step",
            "steps": [
              {
                "id": "dive-one",
                "label": "Roll 4+ on d8",
                "source": { "type": "static-die", "sides": 8 },
                "target": 4,
                "comparator": "gte"
              }
            ]
          },
          "successMessage": "You surface with a glittering stash.",
          "successEffects": [
            {
              "type": "currency",
              "minAmount": 5,
              "maxAmount": 5
            }
          ],
          "failureMessage": "The undertow clips your ankle.",
          "failureEffects": [
            {
              "type": "temporary-roll-penalty",
              "divisor": 3,
              "rolls": 6,
              "stackMode": "replace"
            }
          ]
        },
        {
          "id": "deep-pull",
          "label": "Deep pull",
          "prompt": "Roll 6+ on d8 to drag up the heavy chest.",
          "actionLabel": "Dive deeper",
          "rollChallenge": {
            "id": "example-push-step-two",
            "mode": "single-step",
            "steps": [
              {
                "id": "dive-two",
                "label": "Roll 6+ on d8",
                "source": { "type": "static-die", "sides": 8 },
                "target": 6,
                "comparator": "gte"
              }
            ]
          },
          "successMessage": "A bigger chest breaks free from the silt.",
          "successEffects": [
            {
              "type": "currency",
              "minAmount": 9,
              "maxAmount": 9
            }
          ],
          "failureMessage": "The cold closes over your grip and the whole haul slips away.",
          "failureEffects": [
            {
              "type": "temporary-roll-penalty",
              "divisor": 4,
              "rolls": 8,
              "stackMode": "replace"
            }
          ]
        }
      ]
    },
    "outcomes": []
  },
  {
    "id": "example-group-meter",
    "rarity": "rare",
    "title": "Example Group Meter",
    "prompt": "An example bonfire answers louder voices. The more people join in, the bigger the reward.",
    "claimLabel": "Join chorus",
    "claimPolicy": "multi-user",
    "claimWindowSeconds": 60,
    "flow": {
      "type": "group-meter",
      "timeoutResolution": "resolve-current-stage",
      "participantRewardPolicy": "finisher-bonus",
      "stages": [
        {
          "id": "chorus-starts",
          "label": "The chorus starts",
          "prompt": "Reach 2 successful joins.",
          "actionLabel": "Join chorus",
          "requiredSuccesses": 2,
          "rollChallenge": {
            "id": "example-chorus-step-one",
            "mode": "single-step",
            "steps": [
              {
                "id": "chorus-one",
                "label": "Roll 3+ on d6",
                "source": { "type": "static-die", "sides": 6 },
                "target": 3,
                "comparator": "gte"
              }
            ]
          },
          "successMessage": "The fire catches the harmony and throws sparks of luck to everyone present.",
          "successEffects": [
            {
              "type": "currency",
              "minAmount": 4,
              "maxAmount": 4
            }
          ],
          "failureMessage": "You come in off-beat and the chorus has to recover around you.",
          "failureEffects": [
            {
              "type": "temporary-roll-penalty",
              "divisor": 2,
              "rolls": 3,
              "stackMode": "refresh"
            }
          ],
          "failureResolution": "keep-open"
        },
        {
          "id": "chorus-swells",
          "label": "The chorus swells",
          "prompt": "Reach 4 successful joins.",
          "actionLabel": "Join louder",
          "requiredSuccesses": 4,
          "rollChallenge": {
            "id": "example-chorus-step-two",
            "mode": "single-step",
            "steps": [
              {
                "id": "chorus-two",
                "label": "Roll 4+ on d6",
                "source": { "type": "static-die", "sides": 6 },
                "target": 4,
                "comparator": "gte"
              }
            ]
          },
          "successMessage": "The full chorus lands and the bonfire pays out a stronger reward.",
          "successEffects": [
            {
              "type": "currency",
              "minAmount": 7,
              "maxAmount": 7
            }
          ],
          "failureMessage": "The next voice slips and the chorus has to hold without you.",
          "failureEffects": [
            {
              "type": "temporary-roll-penalty",
              "divisor": 2,
              "rolls": 3,
              "stackMode": "refresh"
            }
          ],
          "failureResolution": "keep-open"
        }
      ]
    },
    "outcomes": []
  }
]
