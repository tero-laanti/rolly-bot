# Required: Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=replace-me

# Required for command deployment: Discord application client ID.
DISCORD_CLIENT_ID=replace-me

# Optional: development guild/server ID for fast slash-command updates.
# Leave empty to deploy commands globally instead.
DISCORD_GUILD_ID=

# Required: Discord user ID allowed to run owner-only commands such as
# /self-update and /dice-admin.
DISCORD_OWNER_ID=replace-me

# Optional but recommended for real gameplay data. This points to your private
# rolly-data checkout. If unset, the app tries ./rolly-data and then falls back
# to ./example-data/rolly-data. The data directory is expected to include
# achievements.json, casino.v1.json, dice-balance.json, items.v1.json, pvp.json,
# intro-posts.v1.json, world-boss.v1.json, random-events-balance.json, and
# random-events.v1.json.
# See example-data/rolly-data/world-boss.v1.md for the current World Boss level and HP
# scaling contract.
# ROLLY_DATA_DIR=./rolly-data

# Optional text channel ID where the bot keeps its managed intro posts in sync
# on startup. The feature stays inactive until this is set.
INTRO_POST_CHANNEL_ID=

# Optional text channel ID used for batched achievement unlock announcements.
# Achievements are still awarded when this is unset; only the channel posts are skipped.
ACHIEVEMENTS_CHANNEL_ID=

# Optional text channel ID used for random events. The feature stays inactive
# until this is set.
RANDOM_EVENTS_CHANNEL_ID=

# Optional random-event overrides.

# Target number of random events per day. Default: 10
# RANDOM_EVENTS_TARGET_PER_DAY=10

# Minimum gap between random-event opportunities in minutes. Default: 45
# RANDOM_EVENTS_MIN_GAP_MINUTES=45

# Maximum number of active random events at the same time. Default: 1
# RANDOM_EVENTS_MAX_ACTIVE=1

# Retry delay after a skipped or failed trigger in seconds. Default: 300
# RANDOM_EVENTS_RETRY_DELAY_SECONDS=300

# Scheduling jitter ratio used by the random-event scheduler. Default: 0.35
# RANDOM_EVENTS_JITTER_RATIO=0.35

# Quiet-hours start time in HH:MM 24-hour format. Default: 23:00
# RANDOM_EVENTS_QUIET_HOURS_START=23:00

# Quiet-hours end time in HH:MM 24-hour format. Default: 08:00
# RANDOM_EVENTS_QUIET_HOURS_END=08:00

# IANA timezone used for quiet hours. Default: Europe/Helsinki
# RANDOM_EVENTS_QUIET_HOURS_TIMEZONE=Europe/Helsinki

# Optional World Boss lifecycle and scheduler overrides.

# Text channel ID used for World Boss announcements and active World Boss posts.
# The World Boss runtime stays
# inactive until this is set.
# WORLD_BOSS_CHANNEL_ID=

# Lead time between a World Boss announcement and start in minutes. Default: 30
# WORLD_BOSS_JOIN_LEAD_MINUTES=30

# How long the active World Boss window stays open in minutes. Default: 12
# WORLD_BOSS_ACTIVE_DURATION_MINUTES=12

# Randomly scheduled World Boss fights per day. Set to 0 to disable random
# World Boss scheduling while keeping owner-triggered World Boss runs available.
# Default: 0
# WORLD_BOSS_TARGET_PER_DAY=0

# Minimum gap between World Boss announcements in minutes. Default: 180
# WORLD_BOSS_MIN_GAP_MINUTES=180

# Retry delay after a skipped or failed random World Boss trigger in seconds.
# Default: 600
# WORLD_BOSS_RETRY_DELAY_SECONDS=600

# Scheduling jitter ratio used by the World Boss scheduler. Default: 0.35
# WORLD_BOSS_JITTER_RATIO=0.35

# Quiet-hours start time in HH:MM 24-hour format for random World Boss
# scheduling. Default: 23:00
# WORLD_BOSS_QUIET_HOURS_START=23:00

# Quiet-hours end time in HH:MM 24-hour format for random World Boss
# scheduling. Default: 08:00
# WORLD_BOSS_QUIET_HOURS_END=08:00

# IANA timezone used for World Boss quiet hours. Default: Europe/Helsinki
# WORLD_BOSS_QUIET_HOURS_TIMEZONE=Europe/Helsinki
